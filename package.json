{
  "name": "quint-tree-sitter",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:generated": "tree-sitter generate && git diff --exit-code -- src",
    "generate": "tree-sitter generate",
    "install": "node-gyp-build",
    "test": "tree-sitter test && bun run test:tokens && bun run test:syntax && bun run test:structure",
    "test:structure": "node scripts/check-parse-structure-parity.mjs test/fixtures",
    "test:syntax": "node scripts/check-syntax-acceptance-parity.mjs test/fixtures",
    "test:tokens": "node scripts/check-tokenization-parity.mjs test/fixtures"
  },
  "packageManager": "bun@1.4.0",
  "dependencies": {
    "node-addon-api": "^8.3.1",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@informalsystems/quint": "0.32.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-cli": "0.27.0"
  }
}
