{
  "name": "quint-tree-sitter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:generated": "tree-sitter generate && git diff --exit-code -- src",
    "generate": "tree-sitter generate",
    "install": "node-gyp-build",
    "test": "tree-sitter test && bun run test:tokens && bun run test:syntax",
    "test:syntax": "node scripts/check-syntax-acceptance-parity.mjs test/fixtures",
    "test:tokens": "node scripts/check-tokenization-parity.mjs test/fixtures/tokenization.qnt test/fixtures/tokenization-uppercase-hex.qnt test/fixtures/tokenization-leading-zero.qnt test/fixtures/tokenization-zero-separator.qnt test/fixtures/tokenization-hole-contexts.qnt test/fixtures/tokenization-lone-hole-name.qnt"
  },
  "packageManager": "bun@1.4.0",
  "dependencies": {
    "node-addon-api": "^8.3.1",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "tree-sitter": "^0.25.1",
    "tree-sitter-cli": "0.27.0"
  }
}
