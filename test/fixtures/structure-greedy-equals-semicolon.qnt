module GreedyEquals {
  pure val value = 1
  pure def result = {
    def first(p) = value;
    (1, 2) == def second(p) = (1, 2)
    (1, 2)
  }
  pure def completeHeader(x: int): int = {
    def f(p) = 1
    -x
  }
  pure def nestedHeaders(x: int): int = {
    val n = def first(p) = def second(p) = [1, 2]
    [1, 2]
    -x
    n
  }
}
