{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "quint",
      "camelcase": "Quint",
      "title": "Quint",
      "scope": "source.quint",
      "file-types": [
        "qnt",
        "quint"
      ],
      "injection-regex": "^quint$",
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "class-name": "TreeSitterQuint"
    }
  ],
  "metadata": {
    "version": "0.32.0-rc.3",
    "license": "Apache-2.0",
    "description": "Tree-sitter grammar for Quint",
    "authors": [
      {
        "name": "Ragunath Jawahar",
        "email": "ragunath@legacycode.com",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/LegacyCodeHQ/tree-sitter-quint",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": true
  }
}
